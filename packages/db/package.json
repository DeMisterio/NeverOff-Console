{
  "name": "@neveroff-console/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bootstrap": "tsx --env-file-if-exists=../../.env src/bootstrap.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts up",
    "migrate:status": "tsx --env-file-if-exists=../../.env src/migrate.ts status",
    "reset": "tsx --env-file-if-exists=../../.env src/reset.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@neveroff-console/shared": "*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
