# ---------------------------------------------------------------------------
# NeverOff admin console — environment
# Copy to .env and fill in. .env is gitignored and must stay that way.
# ---------------------------------------------------------------------------

# --- Which database this process talks to ---------------------------------
# Local development (docker-compose):
DATABASE_URL=postgresql://console:console_local_dev@localhost:54322/neveroff
#
# Production is the real Supabase project. Take this from the NeverOff repo's
# .env as SUPABASE_DB_URL (Dashboard -> Settings -> Database -> Connection string).
# Use the *session* pooler or a direct connection — migrations need a real
# session, not the transaction pooler on port 6543.
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Guard rail. Migrations and the seed script refuse to run against a host that
# is not listed here. Seeding additionally refuses any non-local host outright,
# so synthetic users can never be written into the real project.
DB_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to the literal string below to acknowledge that this process is pointed at
# production. Without it, any migration touching an existing NeverOff table
# (messages, profiles, channel_posts) aborts. Deliberately tedious.
PRODUCTION_MIGRATION_ACK=

# --- Supabase (for enforcement write-back and admin-initiated messages) ----
SUPABASE_URL=
# Server-side secret key. NEVER goes near the web bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase Cloud Messaging (user notifications on ban / unban / appeal) --
# Same service account the push-notify edge function already uses.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- API ------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
# Origin of the web console. Used for CORS and cookie scoping. The console is
# expected to live on its own hostname, separate from any user-facing surface.
WEB_ORIGIN=http://localhost:5173

# 32+ byte random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Encrypts stored TOTP secrets at rest, so a database leak alone does not hand
# an attacker every admin's second factor.
TOTP_ENCRYPTION_KEY=

# Session lifetime controls (§1.3).
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Optional IP allowlist for the admin console, comma separated CIDRs.
# Empty means no IP restriction.
ADMIN_IP_ALLOWLIST=

# Redis is deliberately absent. §9.1 suggests it, but nothing here uses it:
# the job queue is Postgres-backed with FOR UPDATE SKIP LOCKED so that an
# enforcement action, its audit entry and its notification share one
# transaction. Add Redis when the analytics fan-out needs it, not before.

# --- Policy knobs (spec placeholders, now real config) --------------------
# Tier 2 cannot issue a temporary ban longer than this.
MAX_BAN_DAYS_T2=30
# Bulk actions over this many users require a second admin's approval.
BULK_THRESHOLD=50
# Appeals must be answered within this window before auto-escalation.
APPEAL_SLA_HOURS=72

# --- Observability --------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
